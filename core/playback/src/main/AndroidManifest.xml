<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The <uses-permission> entries (FOREGROUND_SERVICE,
      FOREGROUND_SERVICE_MEDIA_PLAYBACK, POST_NOTIFICATIONS, WAKE_LOCK) live in
      the app manifest; declaring them here as well would only duplicate them.
    -->
    <application>
        <service
            android:name="dev.tapio.hush.core.playback.service.HushPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
