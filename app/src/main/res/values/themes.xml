<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Compose canvas so cold start shows no flash. -->
    <style name="Theme.Hush" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hush_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
