<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Crescent: a 19-radius disc at (54,49) minus a 14-radius disc at (59,49),
      each drawn as two half-turn arcs, with even-odd fill. (The earlier
      single path asked for a 15-radius arc across a 38-unit chord, which the
      SVG rule inflates to 19, so both arcs traced the same semicircle and the
      moon rendered as a hairline.) The small disc stays inside the big one,
      so the horns meet at the right edge.
    -->
    <path
        android:fillColor="#ECEBF5"
        android:fillType="evenOdd"
        android:pathData="M35,49 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 z M45,49 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 z" />
    <!-- Three wave lines, thinning downwards. -->
    <path
        android:strokeColor="#7FA6FF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M31,74 q6,-5 12,0 t12,0 t12,0 t12,0" />
    <path
        android:strokeColor="#7FA6FF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeAlpha="0.7"
        android:pathData="M35,82 q5,-4 10,0 t10,0 t10,0 t10,0" />
    <path
        android:strokeColor="#7FA6FF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.4"
        android:pathData="M40,89 q4,-3 8,0 t8,0 t8,0 t8,0" />
</vector>
