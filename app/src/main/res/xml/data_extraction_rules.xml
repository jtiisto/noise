<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: the same scope for cloud backup and device-to-device transfer (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
